{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/learning-1.0.json",
  "title": "DevFlow Learning Frontmatter 契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "learningId",
    "learningType",
    "component",
    "componentRoot",
    "status",
    "sensitivity",
    "capturedAt",
    "lastVerifiedAt",
    "sourceChanges",
    "sourceArchives",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "documentType": {
      "const": "devflow-learning"
    },
    "learningId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "learningType": {
      "enum": [
        "problem-solution",
        "design-decision",
        "engineering-practice"
      ]
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "componentRoot": {
      "type": "string",
      "pattern": "^(?:\\.|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "status": {
      "enum": [
        "active",
        "stale",
        "superseded"
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "capturedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lastVerifiedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceChanges": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AR[0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "sourceArchives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/)?specs/archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-AR[0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "canonicalRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "relatedLearnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "categoryMapping": {
    "problem-solution": "problem-solutions",
    "design-decision": "design-decisions",
    "engineering-practice": "engineering-practices"
  }
}
